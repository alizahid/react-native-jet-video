{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "jetvideo"
  ],
  "ios": {
    "iosModuleName": "JetVideo"
  },
  "android": {
    "androidNamespace": [
      "jetvideo"
    ],
    "androidCxxLibName": "JetVideo"
  },
  "autolinking": {
    "VideoView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridVideoView"
      }
    },
    "VideoConfig": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridVideoConfig"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
