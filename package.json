{
  "name": "react-native-jet-video",
  "version": "0.0.1-beta.1",
  "description": "A single-component video view for React Native with visibility-based autoplay, fullscreen, and Picture-in-Picture. Powered by Nitro Modules.",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-jet-video-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src example/src",
    "format": "biome check --write src example/src",
    "test": "jest --passWithNoTests",
    "clean": "git clean -dfX",
    "build": "bun run typecheck && bob build",
    "codegen": "nitrogen && bun run --cwd example pod",
    "prepare": "bob build",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "video",
    "nitro",
    "autoplay",
    "flashlist",
    "picture-in-picture"
  ],
  "files": [
    "src",
    "lib",
    "nitrogen",
    "nitro.json",
    "ios/**/*.swift",
    "*.podspec",
    "README.md"
  ],
  "workspaces": [
    "example"
  ],
  "packageManager": "bun@1.3.14",
  "repository": "https://github.com/alizahid/react-native-jet-video.git",
  "author": "Ali Zahid",
  "license": "MIT",
  "bugs": "https://github.com/alizahid/react-native-jet-video/issues",
  "homepage": "https://github.com/alizahid/react-native-jet-video#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.17",
    "jest": "^30.4.2",
    "nitrogen": "^0.36.3",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "react-native-nitro-modules": "^0.36.3",
    "release-it": "^21.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "composite": false,
            "module": "commonjs",
            "moduleResolution": "node",
            "types": [
              "jest"
            ],
            "verbatimModuleSyntax": false
          }
        }
      ]
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
