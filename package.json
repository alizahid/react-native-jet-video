{
  "name": "react-native-nitro-video",
  "version": "0.1.0",
  "description": "A single-component video view for React Native with visibility-based autoplay, fullscreen, and Picture-in-Picture. Powered by Nitro Modules.",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src example/App.tsx example/src",
    "format": "biome check --write src example/App.tsx example/src",
    "test": "jest --passWithNoTests",
    "clean": "git clean -dfX",
    "build": "npm run typecheck && bob build",
    "codegen": "nitrogen",
    "postcodegen": "npm --prefix example run pod"
  },
  "keywords": [
    "react-native",
    "video",
    "nitro",
    "autoplay",
    "flashlist",
    "picture-in-picture"
  ],
  "files": [
    "src",
    "lib",
    "nitrogen",
    "nitro.json",
    "ios/**/*.swift",
    "*.podspec",
    "README.md"
  ],
  "workspaces": [
    "example"
  ],
  "repository": "https://github.com/alizahid/react-native-video.git",
  "author": "Ali Zahid",
  "license": "MIT",
  "bugs": "https://github.com/alizahid/react-native-video/issues",
  "homepage": "https://github.com/alizahid/react-native-video#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.2",
    "@types/jest": "^29.5.12",
    "@types/react": "19.2.0",
    "jest": "^29.7.0",
    "nitrogen": "^0.36.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.40.18",
    "react-native-nitro-modules": "^0.36.1",
    "ts-jest": "^29.2.5",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "composite": false,
            "module": "commonjs",
            "moduleResolution": "node",
            "types": [
              "jest"
            ],
            "verbatimModuleSyntax": false
          }
        }
      ]
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
